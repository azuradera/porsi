generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum ExtensionType {
  AUTOMATIC
  MANUAL
}

enum ExpenseCategory {
  INGREDIENTS
  SALARY
  TRANSPORT
  UTILITIES
  EQUIPMENT
  OTHER
}

model Customer {
  id        String         @id @default(cuid())
  code      String         @unique @db.VarChar(6)
  name      String         @db.VarChar(100)
  phone     String?        @db.VarChar(20)
  address   String?        @db.Text
  status    CustomerStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  subscriptions Subscription[]
  noMealDays    NoMealDay[]

  @@index([name])
  @@index([status])
}

model Package {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  price       Decimal  @db.Decimal(12, 2)
  durationDays Int     @default(30)
  dailyQuota  Int      @default(2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  meals         PackageMeal[]
  subscriptions Subscription[]
}

model PackageMeal {
  id        String   @id @default(cuid())
  packageId String
  mealName  String   @db.VarChar(50)
  createdAt DateTime @default(now())

  package     Package      @relation(fields: [packageId], references: [id], onDelete: Cascade)
  mealPickups MealPickup[]

  @@unique([packageId, mealName])
  @@index([packageId])
}

model Subscription {
  id          String             @id @default(cuid())
  customerId  String
  packageId   String
  price       Decimal            @db.Decimal(12, 2)
  startDate   DateTime           @db.Date
  endDate     DateTime           @db.Date
  status      SubscriptionStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  customer    Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  package     Package                 @relation(fields: [packageId], references: [id], onDelete: Restrict)
  mealPickups MealPickup[]
  noMealDays  NoMealDay[]
  extensions  SubscriptionExtension[]
  payments    Payment[]

  @@index([customerId, status])
  @@index([startDate, endDate])
}

model MealPickup {
  id             String   @id @default(cuid())
  subscriptionId String
  packageMealId  String
  pickupDate     DateTime @db.Date
  pickupTime     DateTime @db.Time(0)
  quantity       Int      @default(1)
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  packageMeal  PackageMeal  @relation(fields: [packageMealId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, pickupDate])
  @@index([packageMealId])
}

model NoMealDay {
  id             String   @id @default(cuid())
  customerId     String
  subscriptionId String
  date           DateTime @db.Date
  processed      Boolean  @default(false)
  createdAt      DateTime @default(now())

  customer     Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscription Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  extension    SubscriptionExtension?

  @@unique([subscriptionId, date])
  @@index([customerId, date])
  @@index([processed, date])
}

model SubscriptionExtension {
  id             String        @id @default(cuid())
  subscriptionId String
  noMealDayId    String?       @unique
  type           ExtensionType
  days           Int
  reason         String?       @db.Text
  previousEndDate DateTime     @db.Date
  newEndDate     DateTime      @db.Date
  createdAt      DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  noMealDay    NoMealDay?   @relation(fields: [noMealDayId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
}

model Payment {
  id             String   @id @default(cuid())
  subscriptionId String
  amount         Decimal  @db.Decimal(12, 2)
  paymentDate    DateTime @default(now())
  method         String?  @db.VarChar(30)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, paymentDate])
}

model Expense {
  id          String          @id @default(cuid())
  description String          @db.VarChar(150)
  category    ExpenseCategory @default(OTHER)
  amount      Decimal         @db.Decimal(12, 2)
  expenseDate DateTime        @db.Date
  notes       String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([expenseDate])
  @@index([category])
}

model SubscriptionDay {
  id             String   @id @default(cuid())
  subscriptionId String
  date           DateTime @db.Date
  processed      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([subscriptionId, date])
  @@index([processed, date])
}